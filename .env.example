# Credenciales de la API de StatsBomb (solo se necesitan para descargar datos y reconstruir el modelo).
# Copia este archivo a .env y llena tus datos. Nunca subas .env al repo.
USER_STATSBOMB=tu_usuario
PSWD_STATSBOMB=tu_contraseña

# Laboratorio de jugadas por texto (opcional). Sin key, la app usa solo el parser de reglas.
OPENROUTER_API_KEY=
# Modelo elegido en docs/NL_BENCHMARK.md (barato, no Anthropic).
OPENROUTER_MODEL=mistralai/mistral-small-3.2-24b-instruct
